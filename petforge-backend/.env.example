# PetForge Backend Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# CORS Configuration
# Comma-separated list of allowed origins for production
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Database Configuration
# IMPORTANT: Use strong credentials in production!
# Format: postgresql://username:password@host:port/database?schema=public
DATABASE_URL="postgresql://username:password@localhost:5432/petforge"

# JWT Configuration
# CRITICAL: Use a strong, randomly generated secret (32+ characters) in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ComfyUI Configuration
COMFYUI_URL=http://localhost:8188
COMFYUI_CLIENT_ID=petforge-client

# Prompt Optimization Features (enable/disable)
COMFYUI_OPTIMIZATION=true
COMFYUI_AB_TESTING=true
COMFYUI_QUALITY_ASSESSMENT=true
COMFYUI_NEGATIVE_DETECTION=true

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/combined.log

# Redis Configuration (for queue system)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
BCRYPT_ROUNDS=12

# Payment Gateway Configuration (WeChat Pay)
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_CERT_PATH=

# Payment Gateway Configuration (Alipay)
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=

# Email Configuration (for notifications)
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@petforge.com

# Analytics and Monitoring
ENABLE_METRICS=true
SENTRY_DSN=

# AI Generation Parameters
DEFAULT_GENERATION_STEPS=20
DEFAULT_CFG_SCALE=7
DEFAULT_SAMPLER=euler
DEFAULT_SCHEDULER=normal

# Quality Assessment Thresholds
QUALITY_THRESHOLD_EXCELLENT=90
QUALITY_THRESHOLD_GOOD=75
QUALITY_THRESHOLD_FAIR=60
QUALITY_THRESHOLD_POOR=40

# A/B Testing Configuration
AB_TEST_MAX_CONCURRENT=5
AB_TEST_MIN_SAMPLES=10
AB_TEST_CONFIDENCE_LEVEL=0.95
AB_TEST_AUTO_SELECT_THRESHOLD=0.1

# Negative Detection Thresholds
NEGATIVE_DETECTION_THRESHOLD_LOW=0.3
NEGATIVE_DETECTION_THRESHOLD_TECHNICAL=0.4
NEGATIVE_DETECTION_THRESHOLD_STYLE=0.5
NEGATIVE_DETECTION_THRESHOLD_INAPPROPRIATE=0.1

# Cache Configuration
CACHE_TTL=3600  # 1 hour
CACHE_MAX_SIZE=1000