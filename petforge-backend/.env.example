# ========================================
# PetForge Backend Environment Config
# ========================================

# Server Configuration
NODE_ENV=development
PORT=4000

# Database
# PostgreSQL connection string
# Format: postgresql://username:password@localhost:5432/database_name?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/petforge?schema=public"

# JWT Authentication
# Generate a secure random string for production
JWT_SECRET=your-super-secret-jwt-key-change-this

# Redis
# Used for Bull queue system
REDIS_URL=redis://localhost:6379

# CORS
# Frontend URL (allows cross-origin requests)
FRONTEND_URL=http://localhost:3000

# AI Service
# ComfyUI service URL for AI image generation
COMFYUI_URL=http://localhost:8188

# Payment Services (Optional)
# WeChat Pay Configuration
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# Alipay Configuration
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_alipay_private_key

# Environment-specific settings
# Development: true, Production: false
DEBUG=true
