# ============================================
# WeChat Pay Configuration
# ============================================
# WeChat Pay AppID (from WeChat Pay Merchant Platform)
WECHAT_PAY_APPID=your_wechat_appid_here

# WeChat Pay Merchant ID (MCHID)
WECHAT_PAY_MCHID=your_mchid_here

# WeChat Pay API v3 Key (32 characters, set in Merchant Platform)
WECHAT_PAY_API_V3_KEY=your_api_v3_key_here

# Path to WeChat Pay private key file (apiclient_key.pem)
WECHAT_PAY_PRIVATE_KEY_PATH=./certs/wechat/apiclient_key.pem

# WeChat Pay certificate serial number
WECHAT_PAY_CERT_SERIAL_NO=your_cert_serial_no_here

# WeChat Pay notification URL (replace with your domain)
WECHAT_PAY_NOTIFY_URL=https://yourdomain.com/api/payments/wechat/notify

# ============================================
# Alipay Configuration
# ============================================
# Alipay AppID (from Alipay Open Platform)
ALIPAY_APPID=your_alipay_appid_here

# Alipay RSA private key (merchant private key)
# Use the original private key, NOT the application private key
ALIPAY_PRIVATE_KEY=your_alipay_private_key_here

# Alipay RSA public key (Alipay public key)
ALIPAY_PUBLIC_KEY=your_alipay_public_key_here

# Alipay gateway URL (production: https://openapi.alipay.com/gateway.do)
# For sandbox: https://openapi.alipaydev.com/gateway.do
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# Alipay notification URL (replace with your domain)
ALIPAY_NOTIFY_URL=https://yourdomain.com/api/payments/alipay/notify

# Alipay return URL (for page pay, replace with your domain)
ALIPAY_RETURN_URL=https://yourdomain.com/payment/success

# ============================================
# Payment Security Configuration
# ============================================
# Enable IP whitelist verification (set to 'false' for testing)
PAYMENT_VERIFY_IP=true

# Payment retry attempts
PAYMENT_MAX_RETRY=3

# Payment timeout in seconds
PAYMENT_TIMEOUT=900
