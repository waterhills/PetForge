# Bull Queue + Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Queue Settings
LOG_LEVEL=info
LOG_FILE=./logs/queue.log

# Queue Processing
MAX_CONCURRENT_JOBS=5
MAX_JOBS_PER_WORKER=2
COMFYUI_LIMIT=3
JOB_TIMEOUT=300000

# Monitoring
HEALTH_CHECK_INTERVAL=30000
CLEANUP_INTERVAL=24
REMOVE_ON_COMPLETE=50
REMOVE_ON_FAIL=20